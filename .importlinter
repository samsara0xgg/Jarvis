[importlinter]
root_package = jarvis

# Top-to-bottom: higher entries may import lower entries.
# The four middle layers are independent siblings (cannot import each other).
# constitution and shared are independent siblings at the bottom (import nothing).
# runtime is the only place allowed to wire across the middle four.
#
# ADR-0002 § Reference sources notes:
# - jarvis.shared.pricing is the canonical home for cross-layer static
#   reference data per ADR-0002 § Reference sources; jarvis.shared sits at the
#   bottom of the DAG and may be imported by any layer above (L3 decide() +
#   L4 cost recording both consume it).
[importlinter:contract:layers]
name = 6-layer architecture
type = layers
layers =
    cli
    runtime
    decision | execution | surface | deployment
    state
    constitution | shared
containers =
    jarvis
